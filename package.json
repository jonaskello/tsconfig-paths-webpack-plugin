{
  "name": "tsconfig-paths-webpack-plugin",
  "version": "5.0.0",
  "description": "Load modules according to tsconfig paths in webpack.",
  "main": "lib/mod.js",
  "types": "lib/mod.d.ts",
  "type": "module",
  "author": "Jonas Kello",
  "license": "MIT",
  "repository": "https://github.com/dividab/tsconfig-paths-webpack-plugin",
  "dependencies": {
    "chalk": "^5.6.2",
    "tapable": "^2.3.3",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^5.22.0",
    "@typescript-eslint/parser": "^5.22.0",
    "eslint": "^8.14.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsdoc": "^50.4.3",
    "husky": "^5.1.3",
    "lint-staged": "^10.5.4",
    "prettier": "^2.2.1",
    "typescript": "^7.0.2",
    "webpack": "^5.108.4"
  },
  "scripts": {
    "prepare": "husky install",
    "compile:example": "tsc -p examples/example",
    "example": "yarn build && cd examples/example && webpack && node custom-fs.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"./{src,tests}/**/*.ts{,x}\" --ext .js,.ts,.tsx -f visualstudio",
    "lint-staged": "lint-staged",
    "test": "node --test",
    "test-coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=./coverage.lcov --test-reporter=spec --test-reporter-destination=stdout src/tests/*.test.tsx src/tests/*.test.ts",
    "type-check": "tsc --noEmit",
    "verify": "yarn build && yarn lint && yarn test-coverage",
    "preversion": "yarn verify",
    "postversion": "git push --tags && yarn publish --new-version $npm_package_version && git push && echo \"Successfully released version $npm_package_version!\""
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint",
    "*.{ts,tsx,json,css}": "prettier --write"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
