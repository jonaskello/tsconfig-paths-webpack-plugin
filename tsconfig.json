{
  "include": ["src/**/*"],
  "exclude": ["src/tests/**"],
  "buildOptions": {
    "incremental": true
  },
  "compilerOptions": {
     "target": "es6",
     "module": "esnext",
     "rewriteRelativeImportExtensions": true,
     "erasableSyntaxOnly": true,
     "verbatimModuleSyntax": true,
     "noUncheckedSideEffectImports": true,
     "types": ["node"],
     "rootDir": "src",
      "outDir": "lib",
  }
}
